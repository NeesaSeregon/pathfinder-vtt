DB_HOST=localhost
DB_PORT=5432
DB_USER=pathfinder
DB_PASSWORD=pathfinder
DB_NAME=pathfinder
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# Freno de fuerza bruta del login: cuenta SOLO los intentos fallidos, por
# pareja de email + IP. Entrar bien borra la cuenta.
# LOGIN_MAX_FALLOS=5
# LOGIN_BLOQUEO_SEGUNDOS=900

# --- Despliegue con Coolify (docker-compose.prod.yml) ---
# En producción NO hay un .env en el servidor: estas variables se rellenan
# en el PANEL de Coolify (ahí van cifradas). Coolify también pone el HTTPS
# (su Traefik) y el dominio, así que aquí no hay nada de TLS ni DOMINIO.
# Las que hay que definir en el panel: DB_PASSWORD y JWT_SECRET (largas y
# aleatorias). NODE_ENV=production ya va fijado en el compose.
# Opcionales: LOGIN_MAX_FALLOS, LOGIN_BLOQUEO_SEGUNDOS.

# Carpeta donde se guardan los mapas subidos (dentro irá /mapas).
# Si no se define, se usa ./uploads del proyecto (ignorada por git).
# EN DESPLIEGUE debe apuntar a un VOLUMEN montado: si vive dentro del
# contenedor, los mapas se pierden al recrearlo.
# UPLOADS_DIR=/var/lib/pathfinder-vtt/uploads
