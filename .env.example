DB_HOST=localhost
DB_PORT=5432
DB_USER=pathfinder
DB_PASSWORD=pathfinder
DB_NAME=pathfinder
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# Freno de fuerza bruta del login: cuenta SOLO los intentos fallidos, por
# pareja de email + IP. Entrar bien borra la cuenta.
# LOGIN_MAX_FALLOS=5
# LOGIN_BLOQUEO_SEGUNDOS=900

# --- Recuperar contraseña por correo ---
# De DÓNDE se construye el enlace del correo. NUNCA se saca de la cabecera
# Host de la petición: si se hiciera, un atacante pediría la recuperación de
# tu cuenta con un Host suyo y el enlace que te llega apuntaría a su
# servidor. En producción es el dominio real, con https.
# APP_URL=http://localhost:4200

# SMTP del proveedor de correo. SIN MAIL_HOST la aplicación no envía nada:
# escribe los correos en el log (cómodo en desarrollo, ver el enlace y
# copiarlo). Con Resend, que es lo que usamos en producción:
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=465
#   MAIL_USER=resend
#   MAIL_PASSWORD=<la API key de Resend>
#   MAIL_FROM=Pathfinder VTT <no-responder@rolnees.com>
# Va por SMTP y no por el SDK de Resend a propósito: cambiar de proveedor
# (Brevo, Postmark, SES) es cambiar estas variables, sin tocar código.

# Forzar el transporte: consola | smtp. Sin esto se decide solo (hay
# MAIL_HOST → smtp; no lo hay → consola). Sirve para tener el SMTP
# configurado y aun así NO enviar nada mientras se prueba.
# MAIL_TRANSPORTE=consola

# Si se define, el transporte de consola deja además cada correo en un
# .json dentro de esta carpeta. Es lo que permite al e2e de la API leer el
# enlace y completar el flujo sin cuenta de correo. SOLO PARA PRUEBAS: deja
# tokens de recuperación en claro escritos en disco.
# CORREO_BUZON_DIR=./tmp/correos

# Freno de "he olvidado mi contraseña". Cuenta TODAS las peticiones (no solo
# los fallos, al revés que el login): cada acierto manda un correo a un
# tercero, así que sin tope esto sería un cañón de spam ajeno.
# RECUPERACION_MAX_POR_EMAIL=3
# RECUPERACION_MAX_POR_IP=10
# RECUPERACION_VENTANA_SEGUNDOS=3600

# --- Despliegue con Coolify (docker-compose.prod.yml) ---
# En producción NO hay un .env en el servidor: estas variables se rellenan
# en el PANEL de Coolify (ahí van cifradas). Coolify también pone el HTTPS
# (su Traefik) y el dominio, así que aquí no hay nada de TLS ni DOMINIO.
# Las que hay que definir en el panel: DB_PASSWORD, JWT_SECRET (largas y
# aleatorias), APP_URL (https://rolnees.com) y las cinco MAIL_*.
# NODE_ENV=production ya va fijado en el compose.
# SIN LAS MAIL_* NO SE ENVÍA NINGÚN CORREO y nadie puede recuperar su
# contraseña: la API responde 204 igual (no puede delatar nada) y el correo
# no llega nunca. El arranque lo avisa con un error en el log.
# Opcionales: LOGIN_MAX_FALLOS, LOGIN_BLOQUEO_SEGUNDOS, RECUPERACION_*.

# Carpeta donde se guardan los mapas subidos (dentro irá /mapas).
# Si no se define, se usa ./uploads del proyecto (ignorada por git).
# EN DESPLIEGUE debe apuntar a un VOLUMEN montado: si vive dentro del
# contenedor, los mapas se pierden al recrearlo.
# UPLOADS_DIR=/var/lib/pathfinder-vtt/uploads
